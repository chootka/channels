# --- LLM Backend ---
# Set to "true" to use local Ollama instead of Claude API
RUN_LOCAL_LLM=true

# Only needed if RUN_LOCAL_LLM is false (Claude API mode)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Channels ---
# Which channel config file to use
# channels.yaml = Claude API version (has rezzy/residue)
# channels_ollama.yaml = Ollama version (has web-mistress)
CHANNELS_FILE=channels_ollama.yaml

# Comma-separated list of channel indices this Pi should respond on
# Leave empty to enable all channels
# Example: ACTIVE_CHANNELS=4 means only channel 4 (sheila) is active
ACTIVE_CHANNELS=4

# --- MQTT (for web-mistress agent) ---
MQTT_BROKER=dweb2025.nohost.me
MQTT_PORT=1883

# --- Meshtastic ---
# Serial port for the Meshtastic device (leave empty for auto-detect)
# MESHTASTIC_SERIAL_PORT=/dev/ttyUSB0

# --- Rate Limiting ---
# Cooldown per sender in seconds (default: 10)
# RATE_LIMIT_SECONDS=10
